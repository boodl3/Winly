<Window x:Class="Winly.App.Panel.FirstRunDisclosureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Before Winly starts" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True">
  <StackPanel Margin="24">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="What Winly can see and hear" />
    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
      Winly only listens and looks while you hold the activation key (Windows + Left Alt by default).
    </TextBlock>
    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
      <Run FontWeight="SemiBold">What is captured:</Run> your microphone while the key is held (30 seconds at most),
      and a single snapshot of every connected display the moment you release it.
    </TextBlock>
    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
      <Run FontWeight="SemiBold">Where it goes:</Run> to the Winly backend, which forwards it to the speech and
      answer services for that one request. Nothing is written to disk and nothing is kept after the answer.
    </TextBlock>
    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
      <Run FontWeight="SemiBold">Your controls:</Run> the tray icon and the companion turn red while capture is active,
      and you can switch screen or microphone capture off at any time in settings.
    </TextBlock>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Quit" Width="90" Margin="0,0,8,0" IsCancel="True" Click="OnQuit" />
      <Button Content="I understand, continue" Width="180" IsDefault="True" Click="OnContinue" />
    </StackPanel>
  </StackPanel>
</Window>
