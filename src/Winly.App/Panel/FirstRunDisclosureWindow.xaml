<Window x:Class="Winly.App.Panel.FirstRunDisclosureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Before Winly starts" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True">
  <Border Margin="12" CornerRadius="16" Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Hairline}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.6" Color="#000000" />
    </Border.Effect>
    <StackPanel Margin="28,26,28,24">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource Paper}">
          <Grid>
            <Ellipse Width="4.5" Height="7" Fill="#1B1A16" HorizontalAlignment="Left"
                     VerticalAlignment="Center" Margin="7.5,0,0,0" />
            <Ellipse Width="4.5" Height="7" Fill="#1B1A16" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Margin="0,0,7.5,0" />
          </Grid>
        </Border>
        <TextBlock Style="{StaticResource Display}" Text="What Winly can see and hear"
                   FontSize="19" Margin="12,0,0,0" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource PaperMuted}">
        Winly only listens and looks while you hold the activation key (Windows + Left Alt by default).
      </TextBlock>

      <Border CornerRadius="12" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Hairline}"
              BorderThickness="1" Padding="16,14" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="12.5">
            <Run FontWeight="SemiBold">What is captured:</Run>
            <Run Foreground="#8C897F">your microphone while the key is held (30 seconds at most),
              and a single snapshot of every connected display the moment you release it.</Run>
          </TextBlock>
          <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12.5">
            <Run FontWeight="SemiBold">Where it goes:</Run>
            <Run Foreground="#8C897F">to the Winly backend, which forwards it to the speech and
              answer services for that one request. Nothing is written to disk and nothing is kept after the answer.</Run>
          </TextBlock>
          <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12.5">
            <Run FontWeight="SemiBold">Your controls:</Run>
            <Run Foreground="#8C897F">the tray icon and the companion turn red while capture is active,
              and you can switch screen or microphone capture off at any time in settings.</Run>
          </TextBlock>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button Content="Quit" Width="90" Margin="0,0,8,0" IsCancel="True" Click="OnQuit" />
        <Button Content="I understand, continue" Style="{StaticResource PrimaryButton}"
                IsDefault="True" Click="OnContinue" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
