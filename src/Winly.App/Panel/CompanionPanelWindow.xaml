<Window x:Class="Winly.App.Panel.CompanionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winly" Width="428" Height="892"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        TextOptions.TextRenderingMode="ClearType">
  <!-- Margin 12 is the shadow's room; Width/Height carry that extra 24 so the card stays 404x868. -->
  <Border Margin="12" CornerRadius="16" Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Hairline}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.6" Color="#000000" />
    </Border.Effect>

    <DockPanel Margin="22,18,22,20">
      <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnHeaderDrag" Background="Transparent">
        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Click="OnClose"
                VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- The companion's own face, inverted for a dark surface: paper body, ink eyes. -->
          <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource Paper}">
            <Grid>
              <Ellipse Width="4.5" Height="7" Fill="#1B1A16" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Margin="7.5,0,0,0" />
              <Ellipse Width="4.5" Height="7" Fill="#1B1A16" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,7.5,0" />
            </Grid>
          </Border>
          <TextBlock Style="{StaticResource Display}" Text="Winly" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
        <Border CornerRadius="12" Background="{StaticResource SurfaceRaised}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="16,14">
          <StackPanel>
            <TextBlock x:Name="StateText" Text="Idle — hold the activation key and ask." TextWrapping="Wrap" />
            <TextBlock x:Name="BackendText" Foreground="{StaticResource PaperFaint}" FontSize="11.5"
                       LineHeight="17" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Foreground="{StaticResource Warning}" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionLabel}" Text="YOU SAID" />
        <TextBlock x:Name="TranscriptText" TextWrapping="Wrap" Foreground="{StaticResource PaperMuted}"
                   MinHeight="20" />
        <TextBlock Style="{StaticResource SectionLabel}" Text="WINLY" />
        <TextBox x:Name="AnswerText" IsReadOnly="True" TextWrapping="Wrap"
                 Height="130" VerticalScrollBarVisibility="Auto" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom">
        <TextBlock Style="{StaticResource SectionLabel}" Text="SETTINGS" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Activation keys" VerticalAlignment="Center" Margin="0,0,14,10"
                     Foreground="{StaticResource PaperMuted}" />
          <TextBox x:Name="ActivationKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="34"
                   VerticalContentAlignment="Center"
                   ToolTip="Keys joined with +, e.g. LWin+LAlt, LCtrl+Space, F9" />
          <TextBlock Grid.Row="1" Text="Companion" VerticalAlignment="Center" Margin="0,0,14,14"
                     Foreground="{StaticResource PaperMuted}" />
          <ComboBox x:Name="VisibilityBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
            <ComboBoxItem Content="Appear only while interacting" Tag="InteractionOnly" />
            <ComboBoxItem Content="Always visible" Tag="AlwaysVisible" />
          </ComboBox>
          <CheckBox x:Name="ScreenCaptureBox" Grid.Row="2" Grid.ColumnSpan="2" Content="Allow screen capture" Margin="0,0,0,14" />
          <CheckBox x:Name="MicrophoneCaptureBox" Grid.Row="3" Grid.ColumnSpan="2" Content="Allow microphone capture" Margin="0,0,0,14" />
          <CheckBox x:Name="DesktopActionsBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBlock Text="Let Winly act on my desktop — open apps, arrange windows, type, change settings"
                       TextWrapping="Wrap" FontSize="13" LineHeight="18" />
          </CheckBox>
          <CheckBox x:Name="RunAtLoginBox" Grid.Row="5" Grid.ColumnSpan="2" Content="Start Winly when I sign in" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button Content="Connect Spotify" Margin="0,0,10,0" Click="OnConnectMusic" />
          <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>

        <TextBlock Style="{StaticResource SectionLabel}" Text="WHAT WINLY HAS DONE" />
        <ListBox x:Name="ActionRecordList" Height="150" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Clear history" Click="OnClearActionRecord" />
        </StackPanel>
      </StackPanel>

      <Border />
    </DockPanel>
  </Border>
</Window>
