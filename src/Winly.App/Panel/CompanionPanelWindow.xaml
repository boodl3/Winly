<Window x:Class="Winly.App.Panel.CompanionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winly" Width="380" Height="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="#FAFAF7">
  <Border BorderBrush="#D9D4C7" BorderThickness="1">
    <DockPanel Margin="16">
      <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnHeaderDrag">
        <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Click="OnClose" Background="Transparent" BorderThickness="0" />
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Winly" VerticalAlignment="Center" />
      </DockPanel>

      <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
        <TextBlock x:Name="StateText" Foreground="#6B6559" Text="Idle — hold the activation key and ask." TextWrapping="Wrap" />
        <TextBlock x:Name="BackendText" Foreground="#8A8477" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Foreground="#B54708" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="You said" />
        <TextBlock x:Name="TranscriptText" TextWrapping="Wrap" Foreground="#3A3630" />
        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Winly" />
        <TextBox x:Name="AnswerText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                 Height="120" VerticalScrollBarVisibility="Auto" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom">
        <TextBlock FontWeight="SemiBold" Text="Settings" Margin="0,8,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Activation keys" VerticalAlignment="Center" Margin="0,0,12,6" />
          <TextBox x:Name="ActivationKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" ToolTip="Keys joined with +, e.g. LWin+LAlt, LCtrl+Space, F9" />
          <TextBlock Grid.Row="1" Text="Companion" VerticalAlignment="Center" Margin="0,0,12,6" />
          <ComboBox x:Name="VisibilityBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
            <ComboBoxItem Content="Appear only while interacting" Tag="InteractionOnly" />
            <ComboBoxItem Content="Always visible" Tag="AlwaysVisible" />
          </ComboBox>
          <CheckBox x:Name="ScreenCaptureBox" Grid.Row="2" Grid.ColumnSpan="2" Content="Allow screen capture" Margin="0,0,0,6" />
          <CheckBox x:Name="MicrophoneCaptureBox" Grid.Row="3" Grid.ColumnSpan="2" Content="Allow microphone capture" Margin="0,0,0,6" />
          <CheckBox x:Name="DesktopActionsBox" Grid.Row="4" Grid.ColumnSpan="2" Content="Let Winly open apps and change volume" Margin="0,0,0,6" />
          <CheckBox x:Name="RunAtLoginBox" Grid.Row="5" Grid.ColumnSpan="2" Content="Start Winly when I sign in" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Content="Connect Spotify" Width="130" Margin="0,0,8,0" Click="OnConnectMusic" />
          <Button Content="Save settings" Width="120" Click="OnSave" />
        </StackPanel>
      </StackPanel>

      <Border />
    </DockPanel>
  </Border>
</Window>
