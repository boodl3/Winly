<Window x:Class="Winly.App.Overlay.CompanionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Winly.App.Overlay"
        Title="Winly overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Focusable="False" IsHitTestVisible="False">
  <Canvas x:Name="Surface">
    <local:SquareBuddyControl x:Name="Buddy" Visibility="Collapsed" />
  </Canvas>
</Window>
