<UserControl x:Class="Winly.App.Overlay.SquareBuddyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="72" Height="80" IsHitTestVisible="False" Focusable="False">
  <!-- Demo-phase companion: a rounded square body and two black eyes, drawn entirely in XAML (FR-021). -->
  <Grid x:Name="Root">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="CompanionStates">
        <VisualStateGroup.Transitions>
          <VisualTransition GeneratedDuration="0:0:0.12" />
        </VisualStateGroup.Transitions>

        <VisualState x:Name="Idle">
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BodyTranslate" Storyboard.TargetProperty="Y"
                             From="0" To="-3" Duration="0:0:1.4" AutoReverse="True" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEyeScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:4.2">
              <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
              <DiscreteDoubleKeyFrame KeyTime="0:0:3.8" Value="0.12" />
              <DiscreteDoubleKeyFrame KeyTime="0:0:3.95" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightEyeScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:4.2">
              <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
              <DiscreteDoubleKeyFrame KeyTime="0:0:3.8" Value="0.12" />
              <DiscreteDoubleKeyFrame KeyTime="0:0:3.95" Value="1" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>

        <VisualState x:Name="Listening">
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="LeftEyeScale" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="RightEyeScale" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="RecordingBadge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
          </Storyboard>
        </VisualState>

        <VisualState x:Name="Working">
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LeftEyeScale" Storyboard.TargetProperty="ScaleY" To="0.35" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="RightEyeScale" Storyboard.TargetProperty="ScaleY" To="0.35" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="BodyTranslate" Storyboard.TargetProperty="X"
                             From="-2" To="2" Duration="0:0:0.6" AutoReverse="True" />
          </Storyboard>
        </VisualState>

        <VisualState x:Name="Speaking">
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.06" Duration="0:0:0.25" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.06" Duration="0:0:0.25" AutoReverse="True" />
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Polygon x:Name="Pointer" Points="0,0 16,0 8,12" Fill="#F2B441" Opacity="0"
             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />

    <Border x:Name="Body" Width="64" Height="64" CornerRadius="14" Background="#F2B441"
            HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="BodyScale" />
          <TranslateTransform x:Name="BodyTranslate" />
        </TransformGroup>
      </Border.RenderTransform>
      <Grid>
        <Ellipse Width="10" Height="14" Fill="Black" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="16,0,0,0" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform x:Name="LeftEyeScale" />
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="10" Height="14" Fill="Black" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform x:Name="RightEyeScale" />
          </Ellipse.RenderTransform>
        </Ellipse>
        <!-- Capture-active badge (FR-027): visible only while listening. -->
        <Ellipse x:Name="RecordingBadge" Width="12" Height="12" Fill="#E5484D" Opacity="0"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
