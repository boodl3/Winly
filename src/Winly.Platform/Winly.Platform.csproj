<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 22621 projection so GraphicsCaptureSession.IsBorderRequired is visible; it is runtime-guarded. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Screen capture needs 19041 (research.md §1); older builds still start and report capture unavailable at runtime. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winly.Core\Winly.Core.csproj" />
    <!-- So the interop struct sizes can be pinned in CI. A wrong sizeof(INPUT) makes SendInput fail
         silently, which killed three verbs for as long as they have existed. -->
    <InternalsVisibleTo Include="Winly.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Windows.Automation (SpotifyUiControl) lives in the WPF half of the Windows Desktop
         runtime, which Winly.App already requires. Referenced directly rather than via UseWPF: that
         property also swaps in WPF's implicit-usings set, which drops System.IO out from under the
         audio code, and drags XAML build targets into a project that has no XAML. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <!-- The only interface that reaches an internal panel's backlight is WMI. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
